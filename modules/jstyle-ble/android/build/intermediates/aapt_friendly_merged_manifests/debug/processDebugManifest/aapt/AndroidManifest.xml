<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.labtrack.jstyleble" >
    <!--
      No permissions are declared here on purpose. This module never opens a socket: it
      turns commands into bytes and bytes into dictionaries. The Bluetooth permissions
      belong to whatever owns the radio, which is `react-native-ble-plx`, declared by the
      app's own manifest through the Expo config plugin.
    -->
    <uses-sdk android:minSdkVersion="26" />

</manifest>