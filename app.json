{
  "expo": {
    "name": "LabTrack",
    "slug": "labtrack",
    "scheme": "labtrack",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF385C"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/8a44b0f8-69d5-432b-bdcf-f9a1406bff3e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.labtrack.app"
    },
    "android": {
      "package": "com.labtrack.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8a44b0f8-69d5-432b-bdcf-f9a1406bff3e"
      }
    },
    "runtimeVersion": "1.2.0",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "LabTrack needs access to your photos so you can upload a lab report.",
          "cameraPermission": "LabTrack needs camera access so you can photograph a lab report."
        }
      ]
    ]
  }
}
